{
  "pi-screenshots": {
    "sources": [
      "~/Desktop/CleanShot*.png"
    ]
  },
  "lastChangelogVersion": "0.87.1",
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-5.6-sol",
  "defaultThinkingLevel": "high",
  "enabledModels": [
    "anthropic/claude-haiku-4-5",
    "opencode-go/minimax-m2.7",
    "opencode-go-anthropic/minimax-m2.7",
    "github-copilot/claude-haiku-4.5",
    "github-copilot/claude-opus-4.8",
    "openai-codex/gpt-6-astra",
    "openai-codex/gpt-6-luna",
    "anthropic/claude-opus-5",
    "anthropic/claude-opus-5-5",
    "anthropic/claude-sonnet-5-5",
    "github-copilot/claude-opus-4.7",
    "github-copilot/claude-opus-5",
    "github-copilot/claude-opus-5.5",
    "github-copilot/claude-sonnet-5.5",
    "anthropic/claude-opus-4-8",
    "opencode-go/glm-5.3-flash",
    "opencode-go/deepseek-v4-pro",
    "opencode-go/deepseek-v4.1-flash",
    "opencode-go/kimi-k2.7-code",
    "opencode-go/grok-4.6",
    "openai-codex/gpt-6.1-sol"
  ],
  "packages": [
    "npm:pi-subdir-context",
    "npm:pi-extmgr",
    "npm:pi-subagents",
    "npm:pi-mcp-adapter",
    "npm:@aliou/pi-guardrails",
    "npm:@plannotator/pi-extension",
    "npm:@juanibiapina/pi-tokyonight",
    "npm:@ujjwalgrover/pi-catppuccin",
    "npm:pi-powerline-footer",
    "npm:@quintinshaw/pi-dynamic-workflows",
    "npm:pi-observational-memory"
  ],
  "theme": "tokyonight-moon",
  "powerline": {
    "preset": "default",
    "layout": {
      "left": [
        "custom:pi-logo",
        "model",
        "thinking",
        "shell_mode",
        "path",
        "git",
        "subagents"
      ],
      "right": [
        "token_in",
        "token_out",
        "cache_read",
        "cost",
        "context_pct",
        "time_spent",
        "time",
        "extension_statuses"
      ]
    },
    "customItems": [
      {
        "id": "pi-logo",
        "statusKey": "pi-logo",
        "position": "left",
        "color": "accent"
      }
    ],
    "model": {
      "showThinkingLevel": false
    },
    "path": {
      "mode": "abbreviated",
      "maxLength": 50
    },
    "time": {
      "format": "24h",
      "showSeconds": false
    },
    "fixedEditor": true
  },
  "workingVibe": "star wars",
  "tuiMode": "fullscreen",
  "outputPad": 1,
  "compaction": {
    "modelOverrides": {
      "openai-codex/gpt-6.1-sol": {
        "reserveTokens": 340000,
        "keepRecentTokens": 30000
      },
      "anthropic/claude-sonnet-5-5": {
        "reserveTokens": 840000,
        "keepRecentTokens": 30000
      },
      "anthropic/claude-opus-5-5": {
        "reserveTokens": 840000,
        "keepRecentTokens": 30000
      }
    }
  },
  "subagents": {
    "defaultSubagentOnlyExtensions": [
      "~/.pi/agent/extensions/pi-to-PI-fix.ts"
    ]
  }
}
