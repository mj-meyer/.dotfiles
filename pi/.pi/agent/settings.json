  "packages": [
    "npm:pi-subdir-context",
    "npm:pi-extmgr",
    "npm:pi-subagents",
    "npm:pi-mcp-adapter",
    "npm:@aliou/pi-guardrails",
    "npm:@plannotator/pi-extension",
    "npm:@juanibiapina/pi-tokyonight",
    "npm:@ujjwalgrover/pi-catppuccin",
    "npm:pi-powerline-footer",
    "npm:@quintinshaw/pi-dynamic-workflows",
    "npm:pi-observational-memory"
  ],
  "theme": "tokyonight-moon",
  "powerline": {
    "preset": "default",
    "layout": {
      "left": [
        "custom:pi-logo",
        "model",
        "thinking",
        "shell_mode",
        "path",
        "git",
        "subagents"
      ],
      "right": [
        "token_in",
        "token_out",
        "cache_read",
        "cost",
        "context_pct",
        "time_spent",
        "time",
        "extension_statuses"
      ]
    },
    "customItems": [
      {
        "id": "pi-logo",
        "statusKey": "pi-logo",
        "position": "left",
        "color": "accent"
      }
    ],
    "model": {
      "showThinkingLevel": false
    },
    "path": {
      "mode": "abbreviated",
      "maxLength": 50
    },
    "time": {
      "format": "24h",
      "showSeconds": false
    },
    "fixedEditor": true
  },
  "workingVibe": "star wars"
}