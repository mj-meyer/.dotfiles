.DS_Store

# pi agent runtime/state (keep settings + customization resources tracked)
pi/.pi/agent/*
pi/.pi/todos/*

# pi MCP adapter runtime/secrets
pi/.pi/agent/mcp-oauth/
pi/.pi/agent/mcp-cache.json
pi/.pi/agent/mcp-npx-cache.json
pi/.pi/agent/mcp-auth.json
pi/.local/share/pi/mcp-auth.json

!pi/.pi/agent/tsconfig.json
!pi/.pi/agent/package.json
!pi/.pi/agent/cloak.json
!pi/.pi/agent/themes/
!pi/.pi/agent/themes/*.json
!pi/.pi/agent/extensions/
!pi/.pi/agent/extensions/**
!pi/.pi/agent/mcp.json
!pi/.pi/agent/APPEND_SYSTEM.md
!pi/.pi/agent/skills/
!pi/.pi/agent/skills/**
!pi/.pi/agent/settings.json

# pi extension build/runtime junk (must come AFTER the re-includes above)
pi/.pi/agent/extensions/**/node_modules/
pi/.pi/agent/extensions/**/.venv/
pi/.pi/agent/extensions/**/dist/
